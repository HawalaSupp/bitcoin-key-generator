import SwiftUI

// ═══════════════════════════════════════════════════════════════════
//  NodeManagementView.swift
//  HAWALA — Monochrome · Monumental · Mechanical
//
//  Node Management window: view, add, edit, test, delete, failover.
//  Matches the silk-background, sparse-typography, hold-to-confirm
//  design language established in Portfolio / Swap / Buy&Sell.
// ═══════════════════════════════════════════════════════════════════

// MARK: - Root View

struct NodeManagementView: View {
    let onDismiss: () -> Void
    @StateObject private var nodeManager = NodeManager.shared
    @State private var selectedChain: NodeChain = .bitcoin
    @State private var isAddingNode = false
    @State private var editingNode: NodeConfiguration?
    @State private var showFailoverLog = false
    @State private var containerWidth: CGFloat = 800

    private var rs: CGFloat { min(1.0, max(0.55, containerWidth / 900)) }

    var body: some View {
        GeometryReader { geo in
            ZStack {
                // ── Semi-opaque dark base for readability over silk ──
                Color(hex: "0D0D0D").opacity(0.92)
                    .ignoresSafeArea()

                VStack(spacing: 0) {
                    // Header
                    header
                        .padding(.horizontal, max(20, 40 * rs))
                        .padding(.top, max(16, 32 * rs))

                    Spacer().frame(height: max(16, 32 * rs))

                    // Chain selector carousel
                    chainCarousel
                        .padding(.bottom, max(12, 24 * rs))

                    // Hairline divider
                    Rectangle()
                        .fill(Color.white.opacity(0.08))
                        .frame(height: 1)

                    // Main content
                    ScrollView(.vertical, showsIndicators: false) {
                        VStack(spacing: 0) {
                            Spacer().frame(height: max(12, 24 * rs))

                            // Node list for selected chain
                            nodeListSection
                                .padding(.horizontal, max(20, 40 * rs))

                            // Add node expandable area
                            if isAddingNode {
                                addNodeSection
                                    .padding(.horizontal, max(20, 40 * rs))
                                    .padding(.top, max(12, 20 * rs))
                                    .transition(.opacity.combined(with: .move(edge: .bottom)))
                            }

                            Spacer().frame(height: max(12, 24 * rs))

                            // Global settings
                            globalSettingsSection
                                .padding(.horizontal, max(20, 40 * rs))

                            // Failover log
                            if showFailoverLog {
                                failoverLogSection
                                    .padding(.horizontal, max(20, 40 * rs))
                                    .padding(.top, max(8, 16 * rs))
                                    .transition(.opacity.combined(with: .move(edge: .bottom)))
                            }

                            Spacer().frame(height: max(40, 80 * rs))
                        }
                    }
                }
                .frame(maxWidth: .infinity, maxHeight: .infinity)

                // Edit overlay
                if let editing = editingNode {
                    editNodeOverlay(for: editing)
                        .transition(.opacity.combined(with: .scale(scale: 0.96)))
                        .zIndex(50)
                }
            }
            .onAppear { containerWidth = geo.size.width }
            .onChange(of: geo.size.width) { containerWidth = $0 }
        }
        .frame(minWidth: 600, minHeight: 500)
    }

    // ─────────────────────────── Header ───────────────────────────

    private var header: some View {
        HStack(alignment: .firstTextBaseline) {
            VStack(alignment: .leading, spacing: 4) {
                Text("NODE MANAGEMENT")
                    .font(.system(size: max(10, 11 * rs), weight: .semibold))
                    .tracking(4)
                    .foregroundColor(Color.white.opacity(0.35))

                Text("Connections")
                    .font(.system(size: max(28, 36 * rs), weight: .semibold, design: .rounded))
                    .foregroundColor(.white)
            }

            Spacer()

            // Test all button
            Button {
                Task { await nodeManager.testAllNodes(for: selectedChain) }
            } label: {
                HStack(spacing: 6) {
                    Image(systemName: "antenna.radiowaves.left.and.right")
                        .font(.system(size: 11))
                    Text("TEST ALL")
                        .font(.system(size: 10, weight: .bold))
                        .tracking(1.5)
                }
                .foregroundColor(.white.opacity(0.4))
                .padding(.horizontal, 14)
                .padding(.vertical, 8)
                .background(Color.white.opacity(0.07))
                .clipShape(RoundedRectangle(cornerRadius: 8, style: .continuous))
                .overlay(
                    RoundedRectangle(cornerRadius: 8, style: .continuous)
                        .strokeBorder(Color.white.opacity(0.10), lineWidth: 0.5)
                )
            }
            .buttonStyle(.plain)

            // Close button
            Button(action: onDismiss) {
                Image(systemName: "xmark")
                    .font(.system(size: 14, weight: .medium))
                    .foregroundColor(.white.opacity(0.35))
                    .frame(width: 32, height: 32)
                    .background(Color.white.opacity(0.07))
                    .clipShape(Circle())
            }
            .buttonStyle(.plain)
        }
    }

    // ─────────────────────── Chain Carousel ───────────────────────

    private var chainCarousel: some View {
        ScrollView(.horizontal, showsIndicators: false) {
            HStack(spacing: max(4, 8 * rs)) {
                ForEach(NodeChain.allCases) { chain in
                    chainPill(chain)
                }
            }
            .padding(.horizontal, max(20, 40 * rs))
        }
    }

    private func chainPill(_ chain: NodeChain) -> some View {
        let isSelected = selectedChain == chain
        let chainNodes = nodeManager.nodes(for: chain)
        let connectedCount = chainNodes.filter { $0.health.status == .connected }.count

        return Button {
            withAnimation(.spring(response: 0.35, dampingFraction: 0.8)) {
                selectedChain = chain
                isAddingNode = false
            }
        } label: {
            HStack(spacing: 6) {
                // Status indicator — a small circle that communicates health through opacity/form
                Circle()
                    .fill(Color.white.opacity(connectedCount > 0 ? 0.6 : 0.12))
                    .frame(width: 5, height: 5)

                Text(chain.displayName.uppercased())
                    .font(.system(size: max(9, 10 * rs), weight: isSelected ? .bold : .medium))
                    .tracking(isSelected ? 1.5 : 1.0)

                if chainNodes.count > 1 {
                    Text("×\(chainNodes.count)")
                        .font(.system(size: max(8, 9 * rs), weight: .medium, design: .monospaced))
                        .foregroundColor(.white.opacity(0.25))
                }
            }
            .foregroundColor(.white.opacity(isSelected ? 0.85 : 0.30))
            .padding(.horizontal, max(10, 14 * rs))
            .padding(.vertical, max(6, 8 * rs))
            .background(
                RoundedRectangle(cornerRadius: 8, style: .continuous)
                    .fill(Color.white.opacity(isSelected ? 0.12 : 0.03))
            )
            .overlay(
                RoundedRectangle(cornerRadius: 8, style: .continuous)
                    .strokeBorder(Color.white.opacity(isSelected ? 0.15 : 0.04), lineWidth: 0.5)
            )
        }
        .buttonStyle(.plain)
    }

    // ─────────────────────── Node List ───────────────────────────

    private var nodeListSection: some View {
        let chainNodes = nodeManager.nodes(for: selectedChain)

        return VStack(spacing: 0) {
            ForEach(Array(chainNodes.enumerated()), id: \.element.id) { index, node in
                NodeEntryRow(
                    node: node,
                    rs: rs,
                    canDelete: nodeManager.canDeleteNode(node),
                    onTest: { Task { await nodeManager.testNode(node.id) } },
                    onSetDefault: { nodeManager.setDefault(node) },
                    onEdit: { withAnimation(.spring(response: 0.3, dampingFraction: 0.85)) { editingNode = node } },
                    onDelete: { deleteNodeWithConfirmation(node) }
                )

                if index < chainNodes.count - 1 {
                    Rectangle()
                        .fill(Color.white.opacity(0.06))
                        .frame(height: 1)
                        .padding(.leading, 20)
                }
            }

            // Add node trigger (at the end of the list)
            if !isAddingNode {
                Button {
                    withAnimation(.spring(response: 0.4, dampingFraction: 0.8)) {
                        isAddingNode = true
                    }
                } label: {
                    HStack(spacing: 8) {
                        Image(systemName: "plus")
                            .font(.system(size: 11, weight: .medium))
                        Text("ADD NODE")
                            .font(.system(size: 10, weight: .bold))
                            .tracking(1.5)
                    }
                    .foregroundColor(.white.opacity(0.25))
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, max(14, 18 * rs))
                }
                .buttonStyle(.plain)
            }
        }
        .background(Color.white.opacity(0.08))
        .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
        .overlay(
            RoundedRectangle(cornerRadius: 12, style: .continuous)
                .strokeBorder(Color.white.opacity(0.10), lineWidth: 0.5)
        )
    }

    // ──────────────────── Delete Confirmation ────────────────────

    @State private var pendingDelete: NodeConfiguration?
    @State private var deleteProgress: CGFloat = 0
    @State private var isHoldingDelete = false

    private func deleteNodeWithConfirmation(_ node: NodeConfiguration) {
        withAnimation(.spring(response: 0.3, dampingFraction: 0.85)) {
            pendingDelete = node
        }
    }

    // ─────────────────────── Add Node ───────────────────────────

    private var addNodeSection: some View {
        AddNodeForm(
            chain: selectedChain,
            rs: rs,
            onSave: { newNode in
                nodeManager.addNode(newNode)
                withAnimation(.spring(response: 0.3, dampingFraction: 0.85)) {
                    isAddingNode = false
                }
            },
            onCancel: {
                withAnimation(.spring(response: 0.3, dampingFraction: 0.85)) {
                    isAddingNode = false
                }
            }
        )
    }

    // ──────────────────── Global Settings ────────────────────────

    private var globalSettingsSection: some View {
        VStack(spacing: 0) {
            // Auto-failover toggle
            HStack {
                VStack(alignment: .leading, spacing: 3) {
                    Text("AUTO-FAILOVER")
                        .font(.system(size: max(9, 10 * rs), weight: .bold))
                        .tracking(2)
                        .foregroundColor(.white.opacity(0.45))

                    Text("Switch to backup nodes automatically if primary fails")
                        .font(.system(size: max(11, 12 * rs)))
                        .foregroundColor(.white.opacity(0.25))
                }

                Spacer()

                // Custom toggle — no system checkbox
                FailoverToggle(isOn: $nodeManager.autoFailoverEnabled)
            }
            .padding(.horizontal, max(16, 20 * rs))
            .padding(.vertical, max(14, 18 * rs))

            Rectangle()
                .fill(Color.white.opacity(0.06))
                .frame(height: 1)
                .padding(.leading, 20)

            // Failover log toggle
            Button {
                withAnimation(.spring(response: 0.3, dampingFraction: 0.85)) {
                    showFailoverLog.toggle()
                }
            } label: {
                HStack {
                    VStack(alignment: .leading, spacing: 3) {
                        Text("FAILOVER LOG")
                            .font(.system(size: max(9, 10 * rs), weight: .bold))
                            .tracking(2)
                            .foregroundColor(.white.opacity(0.45))

                        if !nodeManager.failoverEvents.isEmpty {
                            Text("\(nodeManager.failoverEvents.count) events recorded")
                                .font(.system(size: max(11, 12 * rs)))
                                .foregroundColor(.white.opacity(0.20))
                        }
                    }

                    Spacer()

                    Image(systemName: showFailoverLog ? "chevron.up" : "chevron.down")
                        .font(.system(size: 10, weight: .medium))
                        .foregroundColor(.white.opacity(0.2))
                }
                .padding(.horizontal, max(16, 20 * rs))
                .padding(.vertical, max(14, 18 * rs))
            }
            .buttonStyle(.plain)
        }
        .background(Color.white.opacity(0.08))
        .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
        .overlay(
            RoundedRectangle(cornerRadius: 12, style: .continuous)
                .strokeBorder(Color.white.opacity(0.10), lineWidth: 0.5)
        )
    }

    // ──────────────────── Failover Log ──────────────────────────

    private var failoverLogSection: some View {
        VStack(spacing: 0) {
            if nodeManager.failoverEvents.isEmpty {
                Text("No failover events recorded")
                    .font(.system(size: 12))
                    .foregroundColor(.white.opacity(0.2))
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 24)
            } else {
                ForEach(nodeManager.failoverEvents.prefix(20)) { event in
                    HStack(alignment: .top, spacing: 12) {
                        // Timeline dot
                        Circle()
                            .fill(Color.white.opacity(0.15))
                            .frame(width: 6, height: 6)
                            .padding(.top, 5)

                        VStack(alignment: .leading, spacing: 3) {
                            HStack(spacing: 6) {
                                Text(event.chain.displayName.uppercased())
                                    .font(.system(size: 9, weight: .bold))
                                    .tracking(1)
                                    .foregroundColor(.white.opacity(0.4))

                                Text(event.timestamp, style: .relative)
                                    .font(.system(size: 9))
                                    .foregroundColor(.white.opacity(0.15))
                            }

                            HStack(spacing: 4) {
                                Text(event.fromNodeLabel)
                                    .font(.system(size: 11, design: .monospaced))
                                    .foregroundColor(.white.opacity(0.3))
                                    .strikethrough(true, color: .white.opacity(0.15))

                                Image(systemName: "arrow.right")
                                    .font(.system(size: 8))
                                    .foregroundColor(.white.opacity(0.15))

                                Text(event.toNodeLabel)
                                    .font(.system(size: 11, design: .monospaced))
                                    .foregroundColor(.white.opacity(0.5))
                            }

                            Text(event.reason)
                                .font(.system(size: 10))
                                .foregroundColor(.white.opacity(0.15))
                        }

                        Spacer()
                    }
                    .padding(.horizontal, max(16, 20 * rs))
                    .padding(.vertical, 10)
                }
            }
        }
        .background(Color.white.opacity(0.06))
        .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
        .overlay(
            RoundedRectangle(cornerRadius: 12, style: .continuous)
                .strokeBorder(Color.white.opacity(0.08), lineWidth: 0.5)
        )
    }

    // ──────────────────── Edit Overlay ───────────────────────────

    private func editNodeOverlay(for node: NodeConfiguration) -> some View {
        ZStack {
            Color.black.opacity(0.7)
                .ignoresSafeArea()
                .onTapGesture {
                    withAnimation(.spring(response: 0.25, dampingFraction: 0.9)) {
                        editingNode = nil
                    }
                }

            EditNodeForm(
                node: node,
                rs: rs,
                onSave: { updated in
                    nodeManager.updateNode(updated)
                    withAnimation(.spring(response: 0.25, dampingFraction: 0.9)) {
                        editingNode = nil
                    }
                },
                onCancel: {
                    withAnimation(.spring(response: 0.25, dampingFraction: 0.9)) {
                        editingNode = nil
                    }
                }
            )
            .frame(maxWidth: 500)
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
//  MARK: - Node Entry Row
// ═══════════════════════════════════════════════════════════════════

struct NodeEntryRow: View {
    let node: NodeConfiguration
    let rs: CGFloat
    let canDelete: Bool
    let onTest: () -> Void
    let onSetDefault: () -> Void
    let onEdit: () -> Void
    let onDelete: () -> Void

    @State private var isHovered = false
    @State private var deleteProgress: CGFloat = 0
    @State private var isHoldingDelete = false
    @State private var deleteWorkItem: DispatchWorkItem?
    @State private var testRipple: CGFloat = 0

    private var depthOffset: CGFloat { node.isDefault ? -2 : 0 }

    var body: some View {
        HStack(alignment: .center, spacing: max(12, 16 * rs)) {
            // ── Status indicator ──
            statusIndicator

            // ── Node info ──
            VStack(alignment: .leading, spacing: 3) {
                HStack(spacing: 8) {
                    Text(node.label)
                        .font(.system(size: max(14, 16 * rs), weight: node.isDefault ? .semibold : .regular))
                        .foregroundColor(.white.opacity(statusOpacity))
                        .strikethrough(node.health.status == .error, color: .white.opacity(0.2))

                    if node.isDefault {
                        Text("DEFAULT")
                            .font(.system(size: 8, weight: .heavy))
                            .tracking(1.5)
                            .foregroundColor(.white.opacity(0.3))
                            .padding(.horizontal, 6)
                            .padding(.vertical, 2)
                            .background(Color.white.opacity(0.08))
                            .clipShape(RoundedRectangle(cornerRadius: 3, style: .continuous))
                    }

                    if node.isBuiltIn {
                        Text("BUILT-IN")
                            .font(.system(size: 8, weight: .medium))
                            .tracking(1)
                            .foregroundColor(.white.opacity(0.15))
                    }
                }

                // URL — monospaced, truncated
                Text(truncatedURL(node.url))
                    .font(.system(size: max(10, 11 * rs), design: .monospaced))
                    .foregroundColor(.white.opacity(0.20))
                    .lineLimit(1)

                // Health details
                HStack(spacing: max(10, 14 * rs)) {
                    if node.health.status == .testing {
                        Text("Testing connection…")
                            .font(.system(size: max(9, 10 * rs)))
                            .foregroundColor(.white.opacity(0.25))
                            .opacity(pulsingOpacity)
                    } else {
                        if let latency = node.health.latencyMs {
                            HStack(spacing: 3) {
                                Text("\(latency)")
                                    .font(.system(size: max(10, 11 * rs), weight: .medium, design: .monospaced))
                                Text("ms")
                                    .font(.system(size: max(8, 9 * rs)))
                            }
                            .foregroundColor(.white.opacity(latencyOpacity(latency)))
                        }

                        if let height = node.health.blockHeight {
                            Text("↑\(formatBlockHeight(height))")
                                .font(.system(size: max(9, 10 * rs), design: .monospaced))
                                .foregroundColor(.white.opacity(0.2))
                        }

                        if let lastConn = node.health.lastConnected {
                            Text(lastConn, style: .relative)
                                .font(.system(size: max(9, 10 * rs)))
                                .foregroundColor(.white.opacity(0.12))
                        }

                        if let error = node.health.lastError {
                            Text(error)
                                .font(.system(size: max(9, 10 * rs)))
                                .foregroundColor(.white.opacity(0.25))
                                .italic()
                        }
                    }
                }
            }

            Spacer()

            // ── Actions ──
            if isHovered {
                HStack(spacing: max(2, 4 * rs)) {
                    nodeActionButton(icon: "antenna.radiowaves.left.and.right", tooltip: "Test", action: onTest)
                    if !node.isDefault {
                        nodeActionButton(icon: "star", tooltip: "Set Default", action: onSetDefault)
                    }
                    nodeActionButton(icon: "pencil", tooltip: "Edit", action: onEdit)
                    if canDelete {
                        deleteButton
                    }
                }
                .transition(.opacity.combined(with: .scale(scale: 0.9)))
            }
        }
        .padding(.horizontal, max(14, 18 * rs))
        .padding(.vertical, max(12, 16 * rs))
        .background(
            RoundedRectangle(cornerRadius: 8, style: .continuous)
                .fill(Color.white.opacity(isHovered ? 0.08 : (node.isDefault ? 0.04 : 0.0)))
        )
        .offset(y: depthOffset)
        .shadow(color: node.isDefault ? Color.black.opacity(0.15) : .clear, radius: 8, y: 4)
        .onHover { hovering in
            withAnimation(.easeOut(duration: 0.15)) { isHovered = hovering }
        }
    }

    // Status indicator — radial pulse for testing, solid for connected
    private var statusIndicator: some View {
        ZStack {
            if node.health.status == .testing {
                // Expanding radial pulse
                Circle()
                    .stroke(Color.white.opacity(0.1), lineWidth: 1)
                    .frame(width: 20 + testRipple * 12, height: 20 + testRipple * 12)
                    .opacity(1 - testRipple)
                    .onAppear {
                        withAnimation(.easeOut(duration: 1.2).repeatForever(autoreverses: false)) {
                            testRipple = 1.0
                        }
                    }
                    .onDisappear { testRipple = 0 }
            }

            Circle()
                .fill(Color.white.opacity(statusDotOpacity))
                .frame(width: 8, height: 8)
                .opacity(node.health.status == .testing ? pulsingOpacity : 1.0)
        }
        .frame(width: 24, height: 24)
    }

    private var statusOpacity: Double {
        switch node.health.status {
        case .connected: return 0.9
        case .disconnected: return 0.45
        case .testing: return 0.6
        case .error: return 0.35
        }
    }

    private var statusDotOpacity: Double {
        switch node.health.status {
        case .connected: return 0.7
        case .disconnected: return 0.15
        case .testing: return 0.35
        case .error: return 0.08
        }
    }

    @State private var pulsePhase = false
    private var pulsingOpacity: Double {
        pulsePhase ? 0.7 : 0.3
    }

    private func latencyOpacity(_ ms: Int) -> Double {
        if ms < 200 { return 0.5 }
        if ms < 500 { return 0.35 }
        return 0.25
    }

    private func nodeActionButton(icon: String, tooltip: String, action: @escaping () -> Void) -> some View {
        Button(action: action) {
            Image(systemName: icon)
                .font(.system(size: 10, weight: .medium))
                .foregroundColor(.white.opacity(0.3))
                .frame(width: 28, height: 28)
                .background(Color.white.opacity(0.07))
                .clipShape(RoundedRectangle(cornerRadius: 6, style: .continuous))
        }
        .buttonStyle(.plain)
        .help(tooltip)
    }

    // ── Hold-to-delete (iris close mechanic) ──
    private var deleteButton: some View {
        ZStack {
            // Iris closing progress
            Circle()
                .trim(from: 0, to: deleteProgress)
                .stroke(Color.white.opacity(0.25), lineWidth: 2)
                .frame(width: 24, height: 24)
                .rotationEffect(.degrees(-90))

            Image(systemName: "trash")
                .font(.system(size: 10, weight: .medium))
                .foregroundColor(.white.opacity(deleteProgress > 0.05 ? 0.5 : 0.25))
        }
        .frame(width: 28, height: 28)
        .background(Color.white.opacity(0.07))
        .clipShape(RoundedRectangle(cornerRadius: 6, style: .continuous))
        .contentShape(Rectangle())
        .gesture(
            DragGesture(minimumDistance: 0)
                .onChanged { _ in
                    guard !isHoldingDelete else { return }
                    isHoldingDelete = true
                    withAnimation(.linear(duration: 1.2)) { deleteProgress = 1.0 }
                    let work = DispatchWorkItem {
                        if isHoldingDelete {
                            onDelete()
                            isHoldingDelete = false
                            withAnimation(.spring(response: 0.3)) { deleteProgress = 0 }
                        }
                    }
                    deleteWorkItem = work
                    DispatchQueue.main.asyncAfter(deadline: .now() + 1.2, execute: work)
                }
                .onEnded { _ in
                    isHoldingDelete = false
                    deleteWorkItem?.cancel()
                    deleteWorkItem = nil
                    withAnimation(.spring(response: 0.3, dampingFraction: 0.7)) { deleteProgress = 0 }
                }
        )
        .help("Hold to delete")
        .onAppear {
            withAnimation(.easeInOut(duration: 1.5).repeatForever(autoreverses: true)) {
                pulsePhase = true
            }
        }
    }

    // Helpers

    private func truncatedURL(_ url: String) -> String {
        var display = url
            .replacingOccurrences(of: "https://", with: "")
            .replacingOccurrences(of: "http://", with: "")
        if display.hasSuffix("/") { display = String(display.dropLast()) }
        if display.count > 48 {
            return String(display.prefix(22)) + "…" + String(display.suffix(22))
        }
        return display
    }

    private func formatBlockHeight(_ h: UInt64) -> String {
        let formatter = NumberFormatter()
        formatter.numberStyle = .decimal
        formatter.groupingSeparator = ","
        return formatter.string(from: NSNumber(value: h)) ?? "\(h)"
    }
}

// ═══════════════════════════════════════════════════════════════════
//  MARK: - Add Node Form (Inline Expanding)
// ═══════════════════════════════════════════════════════════════════

struct AddNodeForm: View {
    let chain: NodeChain
    let rs: CGFloat
    let onSave: (NodeConfiguration) -> Void
    let onCancel: () -> Void

    @StateObject private var nodeManager = NodeManager.shared
    @State private var label: String = ""
    @State private var url: String = ""
    @State private var apiKey: String = ""
    @State private var authToken: String = ""
    @State private var requiresAuth = false
    @State private var testStatus: TestStatus = .idle
    @State private var testLatency: Int?
    @State private var testBlockHeight: UInt64?
    @State private var testError: String?
    @State private var fieldPhase: Int = 0

    enum TestStatus { case idle, testing, success, failed }

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            // Header
            HStack {
                Text("NEW NODE — \(chain.displayName.uppercased())")
                    .font(.system(size: max(9, 10 * rs), weight: .bold))
                    .tracking(2)
                    .foregroundColor(.white.opacity(0.35))

                Spacer()

                Button(action: onCancel) {
                    Text("CANCEL")
                        .font(.system(size: 9, weight: .bold))
                        .tracking(1.5)
                        .foregroundColor(.white.opacity(0.25))
                }
                .buttonStyle(.plain)
            }
            .padding(.horizontal, max(16, 20 * rs))
            .padding(.top, max(16, 20 * rs))
            .padding(.bottom, max(12, 16 * rs))

            // Fields appear sequentially
            VStack(alignment: .leading, spacing: max(10, 14 * rs)) {
                // Label
                if fieldPhase >= 0 {
                    nodeTextField(
                        title: "LABEL",
                        placeholder: "My Bitcoin Node",
                        text: $label,
                        isMono: false
                    )
                    .transition(.opacity.combined(with: .offset(y: 10)))
                }

                // URL
                if fieldPhase >= 1 {
                    nodeTextField(
                        title: "RPC ENDPOINT",
                        placeholder: "https://your-node.example.com",
                        text: $url,
                        isMono: true
                    )
                    .transition(.opacity.combined(with: .offset(y: 10)))
                }

                // API Key (optional)
                if fieldPhase >= 2 && !url.isEmpty {
                    nodeTextField(
                        title: "API KEY (OPTIONAL)",
                        placeholder: "your-api-key",
                        text: $apiKey,
                        isMono: true
                    )
                    .transition(.opacity.combined(with: .offset(y: 10)))

                    // Auth toggle
                    HStack {
                        Text("REQUIRES AUTH")
                            .font(.system(size: max(8, 9 * rs), weight: .bold))
                            .tracking(1.5)
                            .foregroundColor(.white.opacity(0.25))

                        Spacer()

                        FailoverToggle(isOn: $requiresAuth)
                    }
                    .padding(.horizontal, max(16, 20 * rs))
                    .transition(.opacity.combined(with: .offset(y: 10)))

                    if requiresAuth {
                        nodeTextField(
                            title: "AUTH TOKEN",
                            placeholder: "Bearer token",
                            text: $authToken,
                            isMono: true
                        )
                        .transition(.opacity.combined(with: .offset(y: 10)))
                    }
                }
            }
            .padding(.bottom, max(12, 16 * rs))
            .onChange(of: label) { _ in advanceFieldPhase() }
            .onChange(of: url) { _ in advanceFieldPhase() }

            // Test + Save buttons
            if !url.isEmpty {
                HStack(spacing: max(8, 12 * rs)) {
                    // Test button
                    Button {
                        Task { await testConnection() }
                    } label: {
                        HStack(spacing: 6) {
                            if testStatus == .testing {
                                Image(systemName: "arrow.clockwise")
                                    .font(.system(size: 10, weight: .medium))
                                    .foregroundColor(.white.opacity(0.5))
                            } else {
                                Image(systemName: "antenna.radiowaves.left.and.right")
                                    .font(.system(size: 10))
                            }
                            Text(testStatusLabel)
                                .font(.system(size: 10, weight: .bold))
                                .tracking(1.5)
                        }
                        .foregroundColor(.white.opacity(testStatus == .testing ? 0.4 : 0.35))
                        .frame(maxWidth: .infinity)
                        .padding(.vertical, max(10, 12 * rs))
                        .background(Color.white.opacity(0.07))
                        .clipShape(RoundedRectangle(cornerRadius: 8, style: .continuous))
                        .overlay(
                            RoundedRectangle(cornerRadius: 8, style: .continuous)
                                .strokeBorder(Color.white.opacity(0.08), lineWidth: 0.5)
                        )
                    }
                    .buttonStyle(.plain)
                    .disabled(testStatus == .testing)

                    // Save — hold-to-confirm (active only after successful test or manual save)
                    if testStatus == .success {
                        HoldToConfirmButton(label: "HOLD TO SAVE", duration: 1.0) {
                            saveNode()
                        }
                        .transition(.opacity.combined(with: .scale(scale: 0.95)))
                    }
                }
                .padding(.horizontal, max(16, 20 * rs))
                .padding(.bottom, max(16, 20 * rs))
                .transition(.opacity.combined(with: .offset(y: 10)))

                // Test results
                if testStatus == .success {
                    HStack(spacing: max(10, 14 * rs)) {
                        if let latency = testLatency {
                            HStack(spacing: 3) {
                                Text("\(latency)")
                                    .font(.system(size: 11, weight: .medium, design: .monospaced))
                                Text("ms")
                                    .font(.system(size: 9))
                            }
                            .foregroundColor(.white.opacity(0.4))
                        }
                        if let height = testBlockHeight {
                            Text("Block \(height)")
                                .font(.system(size: 10, design: .monospaced))
                                .foregroundColor(.white.opacity(0.25))
                        }
                    }
                    .padding(.horizontal, max(16, 20 * rs))
                    .padding(.bottom, 12)
                    .transition(.opacity)
                }

                if testStatus == .failed, let error = testError {
                    Text(error)
                        .font(.system(size: 10))
                        .foregroundColor(.white.opacity(0.3))
                        .italic()
                        .padding(.horizontal, max(16, 20 * rs))
                        .padding(.bottom, 12)
                        .transition(.opacity)
                }
            }
        }
        .background(Color.white.opacity(0.08))
        .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
        .overlay(
            RoundedRectangle(cornerRadius: 12, style: .continuous)
                .strokeBorder(Color.white.opacity(0.10), lineWidth: 0.5)
        )
        .onAppear {
            withAnimation(.easeOut(duration: 0.3).delay(0.1)) {
                fieldPhase = 0
            }
        }
    }

    private func nodeTextField(title: String, placeholder: String, text: Binding<String>, isMono: Bool) -> some View {
        VStack(alignment: .leading, spacing: 4) {
            Text(title)
                .font(.system(size: max(8, 9 * rs), weight: .bold))
                .tracking(1.5)
                .foregroundColor(.white.opacity(0.25))

            TextField(placeholder, text: text)
                .textFieldStyle(.plain)
                .font(isMono ? .system(size: max(12, 13 * rs), design: .monospaced) : .system(size: max(12, 14 * rs)))
                .foregroundColor(.white.opacity(0.8))
                .padding(.horizontal, 12)
                .padding(.vertical, 10)
                .background(Color.white.opacity(0.07))
                .clipShape(RoundedRectangle(cornerRadius: 8, style: .continuous))
                .overlay(
                    RoundedRectangle(cornerRadius: 8, style: .continuous)
                        .strokeBorder(Color.white.opacity(0.10), lineWidth: 0.5)
                )
        }
        .padding(.horizontal, max(16, 20 * rs))
    }

    private func advanceFieldPhase() {
        let target: Int
        if !label.isEmpty && !url.isEmpty {
            target = 2
        } else if !label.isEmpty {
            target = 1
        } else {
            target = 0
        }
        if target > fieldPhase {
            withAnimation(.spring(response: 0.4, dampingFraction: 0.8).delay(0.15)) {
                fieldPhase = target
            }
        }
    }

    private var testStatusLabel: String {
        switch testStatus {
        case .idle: return "TEST"
        case .testing: return "TESTING…"
        case .success: return "CONNECTED"
        case .failed: return "RETRY TEST"
        }
    }

    private func testConnection() async {
        testStatus = .testing
        testError = nil

        let tempNode = NodeConfiguration(
            chain: chain,
            label: label.isEmpty ? "Test" : label,
            url: url,
            apiKey: apiKey.isEmpty ? nil : apiKey,
            requiresAuth: requiresAuth,
            authToken: requiresAuth ? (authToken.isEmpty ? nil : authToken) : nil
        )

        // Add temporarily for testing
        nodeManager.addNode(tempNode)
        await nodeManager.testNode(tempNode.id)

        // Read result
        if let tested = nodeManager.nodes.first(where: { $0.id == tempNode.id }) {
            if tested.health.status == .connected {
                testStatus = .success
                testLatency = tested.health.latencyMs
                testBlockHeight = tested.health.blockHeight
            } else {
                testStatus = .failed
                testError = tested.health.lastError ?? "Connection failed"
            }
            // Remove temp node — will be re-added on save
            nodeManager.nodes.removeAll { $0.id == tempNode.id }
            nodeManager.saveNodes()
        } else {
            testStatus = .failed
            testError = "Test interrupted"
        }
    }

    private func saveNode() {
        let newNode = NodeConfiguration(
            chain: chain,
            label: label.isEmpty ? "Custom \(chain.displayName)" : label,
            url: url,
            apiKey: apiKey.isEmpty ? nil : apiKey,
            requiresAuth: requiresAuth,
            authToken: requiresAuth ? (authToken.isEmpty ? nil : authToken) : nil,
            health: NodeHealth(
                latencyMs: testLatency,
                blockHeight: testBlockHeight,
                lastConnected: Date(),
                lastError: nil,
                status: .connected
            )
        )
        onSave(newNode)
    }
}

// ═══════════════════════════════════════════════════════════════════
//  MARK: - Edit Node Form
// ═══════════════════════════════════════════════════════════════════

struct EditNodeForm: View {
    let node: NodeConfiguration
    let rs: CGFloat
    let onSave: (NodeConfiguration) -> Void
    let onCancel: () -> Void

    @State private var label: String = ""
    @State private var url: String = ""
    @State private var apiKey: String = ""
    @State private var authToken: String = ""
    @State private var requiresAuth: Bool = false

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            // Header
            HStack {
                Text("EDIT NODE")
                    .font(.system(size: max(9, 10 * rs), weight: .bold))
                    .tracking(2)
                    .foregroundColor(.white.opacity(0.35))

                Spacer()

                Button(action: onCancel) {
                    Image(systemName: "xmark")
                        .font(.system(size: 12, weight: .medium))
                        .foregroundColor(.white.opacity(0.3))
                        .frame(width: 28, height: 28)
                        .background(Color.white.opacity(0.07))
                        .clipShape(Circle())
                }
                .buttonStyle(.plain)
            }
            .padding(.horizontal, max(16, 24 * rs))
            .padding(.top, max(16, 24 * rs))
            .padding(.bottom, max(12, 20 * rs))

            VStack(alignment: .leading, spacing: max(10, 14 * rs)) {
                editTextField(title: "LABEL", text: $label, isMono: false)
                editTextField(title: "RPC ENDPOINT", text: $url, isMono: true)
                editTextField(title: "API KEY", text: $apiKey, isMono: true)

                HStack {
                    Text("REQUIRES AUTH")
                        .font(.system(size: max(8, 9 * rs), weight: .bold))
                        .tracking(1.5)
                        .foregroundColor(.white.opacity(0.25))
                    Spacer()
                    FailoverToggle(isOn: $requiresAuth)
                }
                .padding(.horizontal, max(16, 24 * rs))

                if requiresAuth {
                    editTextField(title: "AUTH TOKEN", text: $authToken, isMono: true)
                }
            }
            .padding(.bottom, max(16, 20 * rs))

            // Actions
            HStack(spacing: max(8, 12 * rs)) {
                Button(action: onCancel) {
                    Text("CANCEL")
                        .font(.system(size: 10, weight: .bold))
                        .tracking(1.5)
                        .foregroundColor(.white.opacity(0.3))
                        .frame(maxWidth: .infinity)
                        .padding(.vertical, 12)
                        .background(Color.white.opacity(0.07))
                        .clipShape(RoundedRectangle(cornerRadius: 8, style: .continuous))
                }
                .buttonStyle(.plain)

                HoldToConfirmButton(label: "HOLD TO SAVE", duration: 0.8) {
                    var updated = node
                    updated.label = label
                    updated.url = url
                    updated.apiKey = apiKey.isEmpty ? nil : apiKey
                    updated.requiresAuth = requiresAuth
                    updated.authToken = requiresAuth ? (authToken.isEmpty ? nil : authToken) : nil
                    onSave(updated)
                }
            }
            .padding(.horizontal, max(16, 24 * rs))
            .padding(.bottom, max(16, 24 * rs))
        }
        .background(Color(white: 0.12, opacity: 0.98))
        .clipShape(RoundedRectangle(cornerRadius: 14, style: .continuous))
        .overlay(
            RoundedRectangle(cornerRadius: 14, style: .continuous)
                .strokeBorder(Color.white.opacity(0.10), lineWidth: 0.5)
        )
        .shadow(color: .black.opacity(0.6), radius: 40, y: 20)
        .onAppear {
            label = node.label
            url = node.url
            apiKey = node.apiKey ?? ""
            authToken = node.authToken ?? ""
            requiresAuth = node.requiresAuth
        }
    }

    private func editTextField(title: String, text: Binding<String>, isMono: Bool) -> some View {
        VStack(alignment: .leading, spacing: 4) {
            Text(title)
                .font(.system(size: max(8, 9 * rs), weight: .bold))
                .tracking(1.5)
                .foregroundColor(.white.opacity(0.25))

            TextField("", text: text)
                .textFieldStyle(.plain)
                .font(isMono ? .system(size: max(12, 13 * rs), design: .monospaced) : .system(size: max(12, 14 * rs)))
                .foregroundColor(.white.opacity(0.8))
                .padding(.horizontal, 12)
                .padding(.vertical, 10)
                .background(Color.white.opacity(0.07))
                .clipShape(RoundedRectangle(cornerRadius: 8, style: .continuous))
                .overlay(
                    RoundedRectangle(cornerRadius: 8, style: .continuous)
                        .strokeBorder(Color.white.opacity(0.10), lineWidth: 0.5)
                )
        }
        .padding(.horizontal, max(16, 24 * rs))
    }
}

// ═══════════════════════════════════════════════════════════════════
//  MARK: - Custom Toggle (Mechanical)
// ═══════════════════════════════════════════════════════════════════

struct FailoverToggle: View {
    @Binding var isOn: Bool

    var body: some View {
        Button {
            withAnimation(.spring(response: 0.3, dampingFraction: 0.7)) {
                isOn.toggle()
            }
        } label: {
            ZStack(alignment: isOn ? .trailing : .leading) {
                // Track
                RoundedRectangle(cornerRadius: 10, style: .continuous)
                    .fill(Color.white.opacity(isOn ? 0.12 : 0.04))
                    .frame(width: 38, height: 20)
                    .overlay(
                        RoundedRectangle(cornerRadius: 10, style: .continuous)
                            .strokeBorder(Color.white.opacity(isOn ? 0.15 : 0.06), lineWidth: 0.5)
                    )

                // Thumb
                Circle()
                    .fill(Color.white.opacity(isOn ? 0.7 : 0.25))
                    .frame(width: 16, height: 16)
                    .padding(.horizontal, 2)
            }
        }
        .buttonStyle(.plain)
    }
}
